# SQLite file created by `npm run seed` / `npm run dev` — never committed
DATABASE_URL=file:./payload.db

# Any long random string; required by Payload for sessions and scheduled jobs
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public URL this app is served on (used by the admin panel for links)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: credentials created by `npm run seed` (defaults shown in README)
SEED_ADMIN_EMAIL=admin@pawsandhearts.ph
SEED_ADMIN_PASSWORD=choose-a-password
